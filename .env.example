# ---------------------------------------------------------------------------
# APAAR Registry Portal — copy this file to .env and fill in the values.
# .env is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database: EITHER a single connection URL ...
DATABASE_URL="postgresql://apaar_app_user:change-me@localhost:5432/apaar_registry"

# ... OR separate settings (used when DATABASE_URL is empty)
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_DB_NAME="apaar_registry"
SQL_USER="apaar_app_user"
SQL_PASSWORD="change-me"
# Optional admin user for `npm run db:push`
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Secrets (REQUIRED in production, at least 32 random characters each).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development, if left empty, random ones are created in .secrets.local.json.
SESSION_SECRET=""
CREDENTIAL_SIGNING_SECRET=""

# Password for the pre-loaded demo accounts (8+ chars, a letter and a number).
# Development: if empty, a random one is printed in the server console at startup.
# Production: if empty, the demo accounts are locked.
DEMO_PASSWORD=""

# Server
PORT="3000"
# NODE_ENV="production"
